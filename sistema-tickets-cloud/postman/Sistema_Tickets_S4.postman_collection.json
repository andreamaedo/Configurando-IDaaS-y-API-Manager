{
  "info": {
    "name": "Sistema Tickets - Semana 4 (API Gateway + Azure)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "grant_type", "value": "client_credentials", "type": "string" },
      { "key": "accessTokenUrl", "value": "https://login.microsoftonline.com/{{tenant}}/oauth2/v2.0/token", "type": "string" },
      { "key": "clientId", "value": "{{clientId}}", "type": "string" },
      { "key": "clientSecret", "value": "{{clientSecret}}", "type": "string" },
      { "key": "scope", "value": "{{scope}}", "type": "string" },
      { "key": "tokenName", "value": "token-azure", "type": "string" },
      { "key": "addTokenTo", "value": "header", "type": "string" },
      { "key": "headerPrefix", "value": "Bearer", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://XXXX.execute-api.us-east-1.amazonaws.com" },
    { "key": "tenant", "value": "SUTENANT.onmicrosoft.com" },
    { "key": "clientId", "value": "APPLICATION-CLIENT-ID" },
    { "key": "clientSecret", "value": "VALUE-DEL-SECRET" },
    { "key": "scope", "value": "https://SUTENANT.onmicrosoft.com/APPLICATION-CLIENT-ID/.default" },
    { "key": "id", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Sin token (debe dar 401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/tickets/historial"
      }
    },
    {
      "name": "1. Crear resumen de compra",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoTicket\": \"RES-1001\",\n  \"eventoId\": \"EVT-ROCK-2026\",\n  \"usuarioId\": \"USR-01\",\n  \"nombreAsistente\": \"Andrea Maedo\",\n  \"precio\": 35000,\n  \"estado\": \"PAGADO\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/tickets/generar"
      }
    },
    {
      "name": "2. Descargar PDF generado (Send and Download)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/tickets/{{id}}/descargar" }
    },
    {
      "name": "3. Subir resumen a S3",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/tickets/{{id}}/subir-s3" }
    },
    {
      "name": "4. Modificar resumen (reemplaza en S3)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoTicket\": \"RES-1001\",\n  \"eventoId\": \"EVT-ROCK-2026\",\n  \"usuarioId\": \"USR-01\",\n  \"nombreAsistente\": \"Andrea Maedo Corregido\",\n  \"precio\": 30000,\n  \"estado\": \"PAGADO\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/tickets/{{id}}"
      }
    },
    {
      "name": "5. Descargar desde S3 (Send and Download)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/tickets/{{id}}/descargar-s3" }
    },
    {
      "name": "6. Borrar archivo en S3",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/tickets/{{id}}/archivo-s3" }
    },
    {
      "name": "7. Historial",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/tickets/historial" }
    },
    {
      "name": "8. Estadisticas por evento",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/tickets/estadisticas/EVT-ROCK-2026" }
    },
    {
      "name": "9. Eliminar resumen completo",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/tickets/{{id}}" }
    }
  ]
}
